{
  "name": "kasbah",
  "version": "0.1.1",
  "description": "A minimal, fast Starknet indexer in TypeScript: event handlers, Postgres, SQL and GraphQL",
  "license": "Apache-2.0",
  "author": "swan-of-bodom",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swan-of-bodom/kasbah.git"
  },
  "homepage": "https://swan-of-bodom.github.io/kasbah/",
  "bugs": {
    "url": "https://github.com/swan-of-bodom/kasbah/issues"
  },
  "keywords": [
    "starknet",
    "cairo",
    "indexer",
    "indexing",
    "blockchain",
    "events",
    "postgres",
    "graphql",
    "drizzle",
    "typescript",
    "ekubo"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "kasbah": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run",
    "bench": "vitest bench --run",
    "bench:app": "node --env-file-if-exists=.env --no-warnings scripts/bench-app.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "fixtures": "node --env-file=.env scripts/fetch-fixtures.ts",
    "kasbah": "node --env-file-if-exists=.env --no-warnings src/cli/main.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli/main.js",
    "prepack": "pnpm build",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.0",
    "drizzle-orm": "0.45.4",
    "graphql": "^17.0.2",
    "pg": "^8.23.1",
    "pg-copy-streams": "^7.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/ws": "^8.18.2",
    "starknet": "^10.8.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0",
    "ws": "^8.22.0"
  },
  "packageManager": "pnpm@10.30.3"
}
